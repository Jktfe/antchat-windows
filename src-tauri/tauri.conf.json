{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Antchat",
  "version": "0.1.1",
  "identifier": "com.newmodelvc.antchat.windows",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Antchat",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "ant"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "SocialNetworking",
    "copyright": "© 2026 New Model Venture Capital",
    "shortDescription": "ANT Chat — native Windows client for ANT v4 rooms and terminals",
    "longDescription": "Native Windows client for ANT v4. Multi-room chat, native realtime via SSE, ant:// deep-link join, capability-aware UI. Distributed via Scoop (unsigned per JWPK no-cert decision; SmartScreen warning on direct launch is bypassed by Scoop install context). Companion to the macOS Antchat app.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": null,
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      },
      "certificateThumbprint": null,
      "digestAlgorithm": null,
      "timestampUrl": null
    }
  }
}
