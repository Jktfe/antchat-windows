{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ANT Chat",
  "version": "0.1.0",
  "identifier": "com.newmodelvc.antchat.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ANT Chat",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ant"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "SocialNetworking",
    "copyright": "© 2026 New Model Venture Capital",
    "shortDescription": "ANT Chat — native macOS client for ANT v4 rooms and terminals",
    "longDescription": "Native macOS client for ANT v4. Multi-room chat, native PTY-backed terminals, menu-bar quick access, ant:// deep-link join, capability-aware UI. Companion to the iOS ANT Chat app.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: JAMES WILLIAM PETER KING (54D7S73Y9F)",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true
    }
  }
}
